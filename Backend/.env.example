# Copy this file to .env and fill in real values
# NEVER commit .env to git

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

#Set True for zero-setup local dev (SQLite). Production MUST use PostgreSQL. 
USE_SQLITE=True

# PostgreSQL(used wjhen USE_SQLITE=False)
DB_NAME=provprod
DB_USER=provprod_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Email (console backend prints to the terminal — perfect for local testing)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ProvProd <noreply@provprod.local>

# Celery / Redis (for scheduled reminders, smart-skip, review digests)
# Not required if you only use: python manage.py run_jobs
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Time zone
TIME_ZONE=Africa/Lagos
